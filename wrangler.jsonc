{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "portfolio-site",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-01-07",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "build": {
        "command": "npm run build:worker"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "portfolio-db",
            "database_id": "208b6762-7db9-45f3-af06-4efbccf3e09c"
        }
    ],
    "vars": {
        "R2_BUCKET_NAME": "portfolio-images"
    },
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "portfolio-images"
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false
        }
    }
}